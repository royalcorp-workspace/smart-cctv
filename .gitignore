# 1. Environment & Credential Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk
known_hosts

# 2. Biometric Data & Personally Identifiable Information (PII) (CRITICAL)
# Seluruh foto wajah personil, dataset pengenalan, dan embedding vektor
data/known_faces/*
!data/known_faces/.gitkeep
data/face_crops/*
!data/face_crops/.gitkeep
*.npy
*.npz

# 3. Telegram Local Config Overrides
configs/telegram.json
!configs/telegram.json.example

# 4. Storage, SQLite Databases & Media Captures
*.db
*.db-wal
*.db-shm
storage/*.db*
storage/*.jpg
storage/*.png
cameras/**/snapshots/*
!cameras/**/snapshots/.gitkeep
reports/*
!reports/.gitkeep

# 5. Application Logs & System Output
logs/*.log
!logs/.gitkeep
*.log

# 6. Python Runtime & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# 7. Virtual Environments
.venv/
venv/
env/
ENV/

# 8. Temporary Test Media, Artifacts & Screencasts
*.mp4
*.avi
*.mkv
*.mov
scratch/
runs/

# 9. AI Model Weights & Export Caches (Prevent accidental large binary commits)
*.pt
*.onnx
*_openvino_model/

# 10. IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
