# ==============================================================================
# SMART-CCTV GITIGNORE CONFIGURATION (BRANCH V2 / PRODUCTION READY)
# ==============================================================================

# 1. KREDENSIAL & ENVIRONMENT SECRETS (CRITICAL)
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk
known_hosts
configs/telegram.json
!configs/telegram.json.example

# 2. BASIS DATA, LOGS, & MEDIA BUKTI OPERASIONAL
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
storage/*.db*
storage/*.jpg
storage/*.png
storage/snapshots/*
!storage/snapshots/.gitkeep
storage/clips/*
!storage/clips/.gitkeep
cameras/**/snapshots/*
!cameras/**/snapshots/.gitkeep
logs/*.log
*.log
!logs/.gitkeep
reports/*.csv
reports/*
!reports/.gitkeep

# 3. DATA PRIVASI & BIOMETRIK (PII - CRITICAL)
data/known_faces/*
!data/known_faces/.gitkeep
data/face_crops/*
!data/face_crops/.gitkeep
data/known_faces/.embeddings_cache.npz
*.npy
*.npz

# 4. MODEL BOBOT AI (UKURAN BESAR / BINARY WEIGHTS)
models/*.onnx
models/*.xml
models/*.bin
!models/.gitkeep
*.pt
*.onnx
*.xml
*.bin
*_openvino_model/
yolo11n_openvino_model/

# 5. RUNTIME, VIRTUAL ENVIRONMENT, & OS ARTIFACTS
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
ENV/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.bak
*.mp4
*.avi
*.mkv
*.mov
scratch/
runs/
