# Python Runtime & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Virtual Environment
.venv/
venv/
env/
ENV/

# Environment Secrets
.env
.env*.local
!.env.example
configs/telegram.json
!configs/telegram.json.example

# IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

