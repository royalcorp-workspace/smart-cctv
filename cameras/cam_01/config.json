{
  "camera_id": "cam_01",
  "name": "Koridor & Area Transit Depan",
  "source": "rtsp://${CAM01_USER}:${CAM01_PASS}@${CAM01_IP}:${CAM01_PORT}/Streaming/Channels/101",
  "target_resolution": [
    1920,
    1080
  ],
  "detector": {
    "enabled_classes": [
      "person",
      "backpack",
      "handbag",
      "suitcase"
    ],
    "target_classes": [
      "backpack",
      "handbag",
      "suitcase"
    ],
    "confidence_threshold": 0.22,
    "base_conf": 0.22,
    "bag_conf": 0.18
  },
  "face_detector": {
    "enabled": true,
    "model_path": "models/face_detection_yunet_2023mar.onnx",
    "score_threshold": 0.38,
    "nms_threshold": 0.30,
    "detect_interval_frames": 3,
    "face_roi_crop": [100, 40, 1250, 520],
    "alternate_inference": true,
    "min_face_size": 24,
    "aspect_ratio_range": [0.6, 1.4]
  },
  "face_recognizer": {
    "enabled": true,
    "model_path": "models/face_recognition_sface_2021dec.onnx",
    "known_faces_dir": "data/known_faces",
    "cosine_threshold": 0.58
  },
  "telegram": {
    "enabled": true,
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CAM01_CHAT_ID}"
  },
  "web_dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8000,
    "enable_gui": false
  },
  "zones": {
    "zone_1_koridor": {
      "name": "Koridor Utama (Walkway)",
      "detect_unattended": false,
      "dwell_threshold_sec": 3600,
      "dwell_time_threshold": 3600.0,
      "unattended_threshold": 3600.0,
      "min_contour_area": 300
    },
    "zone_1__koridor": {
      "name": "Koridor Utama (Walkway)",
      "detect_unattended": false,
      "dwell_threshold_sec": 3600,
      "dwell_time_threshold": 3600.0,
      "unattended_threshold": 3600.0,
      "min_contour_area": 300
    },
    "zone_2_transit": {
      "name": "Area Transit Depan (Penitipan)",
      "detect_unattended": true,
      "dwell_threshold_sec": 3600,
      "dwell_time_threshold": 3600.0,
      "unattended_threshold": 3600.0,
      "min_contour_area": 250,
      "target_classes": [
        "backpack",
        "handbag",
        "suitcase"
      ]
    },
    "zone_2__transit": {
      "name": "Area Transit Depan (Penitipan)",
      "detect_unattended": true,
      "dwell_threshold_sec": 3600,
      "dwell_time_threshold": 3600.0,
      "unattended_threshold": 3600.0,
      "min_contour_area": 250,
      "target_classes": [
        "backpack",
        "handbag",
        "suitcase"
      ]
    }
  }
}