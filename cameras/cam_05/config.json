{
  "camera_id": "cam_05",
  "name": "AREA UJI COBA",
  "source": "rtsp://${CAM_05_USER}:${CAM_05_PASS}@${CAM_05_IP}:${CAM_05_PORT}/Streaming/Channels/${CAM_05_CHANNEL}",
  "target_resolution": [
    640,
    360
  ],
  "detector": {
    "enabled_classes": [
      "person",
      "backpack",
      "handbag",
      "suitcase",
      "car",
      "bus",
      "truck"
    ],
    "target_classes": [
      "backpack",
      "handbag",
      "suitcase"
    ],
    "confidence_threshold": 0.23,
    "base_conf": 0.23,
    "bag_conf": 0.18,
    "stride": 2
  },
  "face_detector": {
    "enabled": false,
    "model_path": "models/face_detection_yunet_2023mar.onnx",
    "score_threshold": 0.32,
    "nms_threshold": 0.3,
    "detect_interval_frames": 3
  },
  "face_recognizer": {
    "enabled": false,
    "model_path": "models/face_recognition_sface_2021dec.onnx",
    "known_faces_dir": "data/known_faces",
    "cosine_threshold": 0.52
  },
  "motion_gating": {
    "enabled": true,
    "threshold_px": 120,
    "diff_threshold": 25,
    "hangover_sec": 2.0,
    "quiescent_interval": 30
  },
  "telegram": {
    "enabled": true,
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CAM_05_CHAT_ID}"
  },
  "buzzer": {
    "enabled": true,
    "cooldown_sec": 15,
    "timeout_ms": 3000,
    "trigger_events": [
      "tripwire_crossing"
    ]
  },
  "zones": {
    "zone_1": {
      "name": "Area Khusus 1",
      "dwell_threshold_sec": 60.0,
      "dwell_time_threshold": 60.0,
      "detect_unattended": false
    },
    "zone_2": {
      "name": "Area Khusus 2",
      "dwell_threshold_sec": 60.0,
      "dwell_time_threshold": 60.0,
      "detect_unattended": false
    }
  }
}