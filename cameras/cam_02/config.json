{
  "camera_id": "cam_02",
  "name": "Area Parkir POS-2",
  "source": "rtsp://${CAM02_USER}:${CAM02_PASS}@${CAM02_IP}:${CAM02_PORT}/Streaming/Channels/${CAM02_CHANNEL}",
  "target_resolution": [
    640,
    360
  ],
  "detector": {
    "enabled_classes": [
      "person",
      "car",
      "bus",
      "truck",
      "backpack",
      "handbag",
      "suitcase"
    ],
    "target_classes": [
      "person",
      "car",
      "bus",
      "truck",
      "backpack",
      "handbag",
      "suitcase"
    ],
    "confidence_threshold": 0.22,
    "base_conf": 0.22,
    "vehicle_conf": 0.28,
    "bag_conf": 0.18,
    "stride": 2
  },
  "face_detector": {
    "enabled": false,
    "model_path": "models/face_detection_yunet_2023mar.onnx",
    "score_threshold": 0.32,
    "nms_threshold": 0.30,
    "detect_interval_frames": 3,
    "face_roi_crop": [100, 40, 1250, 520],
    "alternate_inference": true,
    "min_face_size": 16,
    "aspect_ratio_range": [0.6, 1.4]
  },
  "face_recognizer": {
    "enabled": false,
    "model_path": "models/face_recognition_sface_2021dec.onnx",
    "known_faces_dir": "data/known_faces",
    "cosine_threshold": 0.52
  },
  "motion_gating": {
    "enabled": true,
    "threshold_px": 100,
    "diff_threshold": 25,
    "hangover_sec": 2.5,
    "quiescent_interval": 30
  },
  "telegram": {
    "enabled": true,
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CAM02_CHAT_ID}"
  },
  "buzzer": {
    "enabled": true,
    "cooldown_sec": 15,
    "timeout_ms": 3000,
    "trigger_events": [
      "tripwire_crossing",
      "vehicle_dwell"
    ]
  },
  "web_dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8000,
    "enable_gui": false
  },
  "zones": {
    "zone_1_koridor": {
      "name": "Zebra Cross / Akses Pejalan Kaki",
      "target_classes": [
        "car",
        "bus",
        "truck"
      ],
      "dwell_threshold_sec": 60.0,
      "alert_label": "HALANGAN ZEBRA CROSS",
      "detect_unattended": false,
      "dwell_time_threshold": 60.0,
      "unattended_threshold": 60.0,
      "min_contour_area": 300
    },
    "zone_2_transit": {
      "name": "Area Transit Parkir Samping",
      "target_classes": [
        "car",
        "bus",
        "truck"
      ],
      "dwell_threshold_sec": 1800.0,
      "alert_label": "PARKIR MELEBIHI BATAS (30M)",
      "detect_unattended": true,
      "dwell_time_threshold": 1800.0,
      "unattended_threshold": 1800.0,
      "min_contour_area": 250
    },
    "zone_3": {
      "name": "Akses Depan Pintu Tengah",
      "target_classes": [
        "car",
        "bus",
        "truck"
      ],
      "dwell_threshold_sec": 1800.0,
      "alert_label": "PARKIR MELEBIHI BATAS (30M)",
      "detect_unattended": true,
      "dwell_time_threshold": 1800.0,
      "unattended_threshold": 1800.0,
      "min_contour_area": 250
    }
  }
}
