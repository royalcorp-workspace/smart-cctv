# ==============================================================================
# SMART CCTV 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan dengan kredensial riil perangkat Anda.
# ==============================================================================

# --- CAMERA 01 (RTSP) ---
CAM01_IP=192.168.1.100
CAM01_PORT=554
CAM01_USER=admin
CAM01_PASS=YourCameraPasswordHere

# --- TELEGRAM BOT NOTIFICATIONS ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_GLOBAL_ADMIN_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_CAM01_CHAT_ID=YOUR_CAM01_CHAT_ID
